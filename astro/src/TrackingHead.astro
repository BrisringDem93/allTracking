---
import {cookieGuardScript, type Options} from '../dist/index.js';
interface Props { options?: Options; }
// Place FIRST in <head>, before author cookie writers; reuse the integration's options.
// Astro's automatic head-inline fallback is appended after author head content.
const script = cookieGuardScript(Astro.props.options);
---
{script && <script is:inline set:html={script} />}
